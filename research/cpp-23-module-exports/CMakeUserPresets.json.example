{
    "version": 10,
    "configurePresets": [
        {
            "name": "my-debug",
            "displayName": "My personal Debug build (Clang)",
            "inherits": "clang-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "MY_CUSTOM_FLAG": "ON"
            }
        }
    ]
}
